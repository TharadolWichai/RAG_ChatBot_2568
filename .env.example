# ====================================
# KKU IntelSphere API (Primary LLM)
# ====================================
OPENAI_API_KEY=your_kku_api_key_here
OPENAI_BASE_URL=https://gen.ai.kku.ac.th/api/v1
OPENAI_MODEL=gemini-2.5-flash-lite
CHATBOT_MODEL=gpt-5-mini

# ====================================
# OpenRouter API (Fallback)
# ====================================
OPENROUTER_API_KEY=your_openrouter_key_here

# ====================================
# AstraDB (Vector Database)
# ====================================
ASTRA_DB_APPLICATION_TOKEN=your_astra_token_here
ASTRA_DB_API_ENDPOINT=your_astra_endpoint_here

# ====================================
# Railway Deployment (Production)
# ====================================
# Backend API URL (set by Railway for frontend service)
CHATBOT_API_URL=https://your-backend-service.railway.app/api/v1/chat/completions
CHATBOT_HEALTH_URL=https://your-backend-service.railway.app/api/v1/health
CHATBOT_META_URL=https://your-backend-service.railway.app/api/v1/chatbot/meta
FEEDBACK_API_URL=https://your-backend-service.railway.app/api/v1/feedback
FEEDBACK_STATS_URL=https://your-backend-service.railway.app/api/v1/feedback/stats

# ====================================
# Local Development
# ====================================
# CHATBOT_API_URL=http://localhost:8000/api/v1/chat/completions
# CHATBOT_HEALTH_URL=http://localhost:8000/api/v1/health
# CHATBOT_META_URL=http://localhost:8000/api/v1/chatbot/meta
# FEEDBACK_API_URL=http://localhost:8000/api/v1/feedback
# FEEDBACK_STATS_URL=http://localhost:8000/api/v1/feedback/stats
