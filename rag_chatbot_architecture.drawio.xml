        <!-- Client -->
        <mxCell id="client" value="Client UI&#10;(Streamlit)"
          style="rounded=0;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="200" height="70" as="geometry"/>
        </mxCell>

        <!-- FastAPI -->
        <mxCell id="api" value="FastAPI Server&#10;server.py : chat()"
          style="rounded=0;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF;"
