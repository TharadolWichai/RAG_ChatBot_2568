          <mxGeometry x="980" y="300" width="200" height="70" as="geometry"/>
        </mxCell>

        <!-- Classifier -->
        <mxCell id="classifier" value="Hybrid Classifier&#10;(Keyword + LLM)"
          style="rounded=0;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF;"
