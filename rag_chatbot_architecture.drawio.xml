          <mxGeometry x="620" y="300" width="300" height="90" as="geometry"/>
        </mxCell>

        <!-- Answer -->
        <mxCell id="answer" value="answer(question)"
          style="rounded=0;whiteSpace=wrap;strokeColor=#000000;fillColor=#FFFFFF;"
